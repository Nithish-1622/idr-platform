# Environment Configuration
# Set DEV_MODE=True to bypass JWT authentication requirement on all API endpoints for local testing
DEV_MODE=True

# Database Configuration
POSTGRES_DB=idr_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/0

# Django Core Settings
SECRET_KEY=django-insecure-sih-2026-idr-backend-super-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
