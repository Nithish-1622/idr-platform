              "mode": "raw",
              "raw": "{\n  \"platform\": \"ANDROID\",\n  \"app_version\": \"1.0.0\",\n  \"current_model_version\": \"0.9.0\",\n  \"current_map_version\": \"2025.12\"\n}"
